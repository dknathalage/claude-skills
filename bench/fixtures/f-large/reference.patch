+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Reports;
+
+public sealed record DailySales(DateOnly Date, int Orders, decimal Total);
+
+public static class SalesReport
+{
+    public static async Task<IResult> ByDay(DateOnly from, DateOnly to, OrdersDbContext db)
+    {
+        if (from > to) return Results.BadRequest();
+        var start = from.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+        var end = to.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc);
+        var paid = await db.Orders.Where(o => o.PaidOn != null && o.PaidOn >= start && o.PaidOn < end).ToListAsync();
+        var list = paid
+            .GroupBy(o => DateOnly.FromDateTime(o.PaidOn!.Value))
+            .OrderBy(g => g.Key)
+            .Select(g => new DailySales(g.Key, g.Count(), g.Sum(o => o.Total)))
+            .ToList();
+        return Results.Ok(list);
+    }
+}
