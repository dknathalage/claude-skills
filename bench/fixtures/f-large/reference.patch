+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Customers;
+
+public sealed record CreateCustomerRequest(string Name, string Email);
+
+public static class CustomerHandlers
+{
+    public static async Task<IResult> Create(CreateCustomerRequest req, OrdersDbContext db)
+    {
+        if (string.IsNullOrWhiteSpace(req.Name) || req.Email is null || !req.Email.Contains('@')) return Results.BadRequest();
+        var email = req.Email.Trim().ToLowerInvariant();
+        if (await db.Customers.AnyAsync(c => c.Email == email)) return Results.Conflict();
+        var customer = new Customer { Name = req.Name, Email = email };
+        db.Customers.Add(customer);
+        await db.SaveChangesAsync();
+        return Results.Created($"/customers/{customer.Id}", customer.ToResponse());
+    }
+
+    public static async Task<IResult> Get(int id, OrdersDbContext db)
+    {
+        var customer = await db.Customers.FindAsync(id);
+        return customer is null ? Results.NotFound() : Results.Ok(customer.ToResponse());
+    }
+
+    public static async Task<IResult> List(OrdersDbContext db)
+        => Results.Ok((await db.Customers.OrderBy(c => c.Id).ToListAsync()).Select(c => c.ToResponse()).ToList());
+}
