+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Reports;
+
+public sealed record ProductSales(int ProductId, string Sku, int Quantity, decimal Revenue);
+
+public static class TopProductsReport
+{
+    public const int DefaultLimit = 5;
+
+    public static async Task<IResult> List(int? limit, OrdersDbContext db)
+    {
+        var take = limit ?? DefaultLimit;
+        if (take < 1) return Results.BadRequest();
+        var lines = await db.Orders
+            .Where(o => o.Status == OrderStatus.Paid || o.Status == OrderStatus.Shipped)
+            .SelectMany(o => o.Lines)
+            .ToListAsync();
+        var skus = await db.Products.ToDictionaryAsync(p => p.Id, p => p.Sku);
+        var list = lines
+            .GroupBy(l => l.ProductId)
+            .Select(g => new ProductSales(g.Key, skus.GetValueOrDefault(g.Key) ?? "", g.Sum(l => l.Quantity), g.Sum(l => l.LineTotal)))
+            .OrderByDescending(p => p.Quantity).ThenBy(p => p.ProductId)
+            .Take(take)
+            .ToList();
+        return Results.Ok(list);
+    }
+}
