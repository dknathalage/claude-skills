@@ -0,0 +1,28 @@
+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Ordering;
+
+public static class CancelOrderHandler
+{
+    public static async Task<IResult> Cancel(int id, OrdersDbContext db, TimeProvider time)
+    {
+        var order = await db.Orders.Include(o => o.Lines).FirstOrDefaultAsync(o => o.Id == id);
+        if (order is null) return Results.NotFound();
+        if (!OrderStatusRules.CanTransition(order.Status, OrderStatus.Cancelled)) return Results.Conflict();
+        foreach (var line in order.Lines)
+        {
+            var stock = await db.Stock.FindAsync(line.ProductId);
+            if (stock is null)
+            {
+                stock = new StockItem { ProductId = line.ProductId };
+                db.Stock.Add(stock);
+            }
+            stock.Quantity += line.Quantity;
+        }
+        order.Status = OrderStatus.Cancelled;
+        order.CancelledOn = time.GetUtcNow().UtcDateTime;
+        await db.SaveChangesAsync();
+        return Results.Ok(order.ToResponse());
+    }
+}
