+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+using Orders.Api.Invoices;
+
+namespace Orders.Api.Ordering;
+
+public static class PayOrderHandler
+{
+    public static async Task<IResult> Pay(int id, OrdersDbContext db, TimeProvider time)
+    {
+        var order = await db.Orders.FirstOrDefaultAsync(o => o.Id == id);
+        if (order is null) return Results.NotFound();
+        if (!OrderStatusRules.CanTransition(order.Status, OrderStatus.Paid)) return Results.Conflict();
+        var now = time.GetUtcNow().UtcDateTime;
+        order.Status = OrderStatus.Paid;
+        order.PaidOn = now;
+        var invoice = new Invoice
+        {
+            OrderId = order.Id,
+            Number = InvoiceNumber.Format(await db.Invoices.CountAsync() + 1),
+            IssuedOn = now,
+            Amount = order.Total,
+        };
+        db.Invoices.Add(invoice);
+        await db.SaveChangesAsync();
+        return Results.Ok(invoice.ToResponse());
+    }
+}
