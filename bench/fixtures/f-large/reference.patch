+++ b/src/Orders.Api/Ordering/PlaceOrderHandler.cs
@@ -0,0 +1,54 @@
+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+using Orders.Api.Pricing;
+
+namespace Orders.Api.Ordering;
+
+public sealed record OrderLineRequest(int ProductId, int Quantity);
+public sealed record PlaceOrderRequest(int CustomerId, List<OrderLineRequest> Lines);
+
+public static class PlaceOrderHandler
+{
+    public static async Task<IResult> Place(PlaceOrderRequest req, OrdersDbContext db, TimeProvider time)
+    {
+        if (req.Lines is null || req.Lines.Count == 0) return Results.BadRequest();
+        if (req.Lines.Any(l => l.Quantity < 1)) return Results.BadRequest();
+        if (req.Lines.Select(l => l.ProductId).Distinct().Count() != req.Lines.Count) return Results.BadRequest();
+        if (!await db.Customers.AnyAsync(c => c.Id == req.CustomerId)) return Results.NotFound();
+
+        var ids = req.Lines.Select(l => l.ProductId).ToList();
+        var products = await db.Products.Where(p => ids.Contains(p.Id)).ToDictionaryAsync(p => p.Id);
+        if (products.Count != ids.Count) return Results.NotFound();
+
+        var stock = await db.Stock.Where(s => ids.Contains(s.ProductId)).ToDictionaryAsync(s => s.ProductId);
+        if (req.Lines.Any(l => l.Quantity > (stock.GetValueOrDefault(l.ProductId)?.Quantity ?? 0))) return Results.Conflict();
+
+        var order = new Order
+        {
+            CustomerId = req.CustomerId,
+            Status = OrderStatus.Pending,
+            CreatedOn = time.GetUtcNow().UtcDateTime,
+        };
+        foreach (var l in req.Lines)
+        {
+            var price = products[l.ProductId].Price;
+            order.Lines.Add(new OrderLine
+            {
+                ProductId = l.ProductId,
+                Quantity = l.Quantity,
+                UnitPrice = price,
+                LineTotal = PriceCalculator.LineTotal(price, l.Quantity),
+            });
+            stock[l.ProductId].Quantity -= l.Quantity;
+        }
+        var totals = OrderTotals.Compute(order.Lines.Select(x => x.LineTotal));
+        order.Subtotal = totals.Subtotal;
+        order.Discount = totals.Discount;
+        order.Tax = totals.Tax;
+        order.Total = totals.Total;
+
+        db.Orders.Add(order);
+        await db.SaveChangesAsync();
+        return Results.Created($"/orders/{order.Id}", order.ToResponse());
+    }
+}
