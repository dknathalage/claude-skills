+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Inventory;
+
+public static class LowStockHandler
+{
+    public const int DefaultThreshold = 5;
+
+    public static async Task<IResult> List(int? threshold, OrdersDbContext db)
+    {
+        var limit = threshold ?? DefaultThreshold;
+        if (limit < 1) return Results.BadRequest();
+        var productIds = await db.Products.Select(p => p.Id).ToListAsync();
+        var stock = await db.Stock.ToDictionaryAsync(s => s.ProductId, s => s.Quantity);
+        var list = productIds
+            .Select(id => new StockResponse(id, stock.GetValueOrDefault(id)))
+            .Where(s => s.Quantity < limit)
+            .OrderBy(s => s.Quantity).ThenBy(s => s.ProductId)
+            .ToList();
+        return Results.Ok(list);
+    }
+}
