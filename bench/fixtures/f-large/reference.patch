+public static class DiscountRule
+{
+    public const decimal SmallThreshold = 100.00m;
+    public const decimal SmallRate = 0.05m;
+    public const decimal LargeThreshold = 500.00m;
+    public const decimal LargeRate = 0.10m;
+
+    public static decimal Discount(decimal subtotal)
+    {
+        var rate = subtotal >= LargeThreshold ? LargeRate : subtotal >= SmallThreshold ? SmallRate : 0m;
+        return Math.Round(subtotal * rate, 2, MidpointRounding.AwayFromZero);
+    }
+}
