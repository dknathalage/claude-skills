+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Catalog;
+
+public sealed record CreateCategoryRequest(string Name);
+
+public static class CategoryHandlers
+{
+    public static async Task<IResult> Create(CreateCategoryRequest req, OrdersDbContext db)
+    {
+        if (string.IsNullOrWhiteSpace(req.Name)) return Results.BadRequest();
+        if (await db.Categories.AnyAsync(c => c.Name == req.Name)) return Results.Conflict();
+        var category = new Category { Name = req.Name };
+        db.Categories.Add(category);
+        await db.SaveChangesAsync();
+        return Results.Created($"/categories/{category.Id}", category.ToResponse());
+    }
+
+    public static async Task<IResult> List(OrdersDbContext db)
+    {
+        var list = (await db.Categories.ToListAsync()).OrderBy(c => c.Name, StringComparer.Ordinal).Select(c => c.ToResponse()).ToList();
+        return Results.Ok(list);
+    }
+}
