+using Microsoft.EntityFrameworkCore;
+using Orders.Api.Data;
+
+namespace Orders.Api.Inventory;
+
+public sealed record AdjustStockRequest(int Delta);
+
+public static class StockHandlers
+{
+    public static async Task<IResult> Get(int productId, OrdersDbContext db)
+    {
+        if (!await db.Products.AnyAsync(p => p.Id == productId)) return Results.NotFound();
+        var stock = await db.Stock.FindAsync(productId);
+        return Results.Ok(new StockResponse(productId, stock?.Quantity ?? 0));
+    }
+
+    public static async Task<IResult> Adjust(int productId, AdjustStockRequest req, OrdersDbContext db)
+    {
+        if (!await db.Products.AnyAsync(p => p.Id == productId)) return Results.NotFound();
+        if (req.Delta == 0) return Results.BadRequest();
+        var stock = await db.Stock.FindAsync(productId);
+        var next = (stock?.Quantity ?? 0) + req.Delta;
+        if (next < 0) return Results.Conflict();
+        if (stock is null)
+        {
+            stock = new StockItem { ProductId = productId };
+            db.Stock.Add(stock);
+        }
+        stock.Quantity = next;
+        await db.SaveChangesAsync();
+        return Results.Ok(stock.ToResponse());
+    }
+}
