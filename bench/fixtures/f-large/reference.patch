+namespace Orders.Api.Pricing;
+
+public sealed record Totals(decimal Subtotal, decimal Discount, decimal Tax, decimal Total);
+
+public static class OrderTotals
+{
+    public static Totals Compute(IEnumerable<decimal> lineTotals)
+    {
+        var subtotal = lineTotals.Sum();
+        var discount = DiscountRule.Discount(subtotal);
+        var tax = TaxCalculator.Tax(subtotal - discount);
+        return new Totals(subtotal, discount, tax, subtotal - discount + tax);
+    }
+}
