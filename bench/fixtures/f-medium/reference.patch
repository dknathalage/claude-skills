@@ -0,0 +1,14 @@
+using Loans.Api.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace Loans.Api.Loans;
+
+public static class OverdueHandler
+{
+    public static async Task<IResult> List(LoansDbContext db, TimeProvider time)
+    {
+        var now = time.GetUtcNow().UtcDateTime;
+        var loans = await db.Loans.Where(l => l.ReturnedOn == null && l.DueOn < now).OrderBy(l => l.DueOn).ToListAsync();
+        return Results.Ok(loans.Select(l => l.ToResponse()).ToList());
+    }
+}
diff --git a/src/Loans.Api/Loans/ReturnHandler.cs b/src/Loans.Api/Loans/ReturnHandler.cs
new file mode 100644
index 0000000..9e41cb1
--- /dev/null
+++ b/src/Loans.Api/Loans/ReturnHandler.cs
@@ -0,0 +1,18 @@
+using Loans.Api.Data;
+
+namespace Loans.Api.Loans;
+
+public static class ReturnHandler
+{
+    public static async Task<IResult> Return(int id, LoansDbContext db, TimeProvider time)
+    {
+        var loan = await db.Loans.FindAsync(id);
+        if (loan is null) return Results.NotFound();
+        if (loan.ReturnedOn is not null) return Results.Conflict();
+        var now = time.GetUtcNow().UtcDateTime;
+        loan.ReturnedOn = now;
+        loan.Fee = FeeCalculator.LateFee(loan.DueOn, now);
+        await db.SaveChangesAsync();
+        return Results.Ok(loan.ToResponse());
+    }
+}
