+using Loans.Api.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace Loans.Api.Books;
+
+public sealed record CreateBookRequest(string Title, string Author);
+public sealed record BookResponse(int Id, string Title, string Author);
+
+public static class BookHandlers
+{
+    public static async Task<IResult> Create(CreateBookRequest req, LoansDbContext db)
+    {
+        if (string.IsNullOrWhiteSpace(req.Title) || string.IsNullOrWhiteSpace(req.Author)) return Results.BadRequest();
+        var book = new Book { Title = req.Title, Author = req.Author };
+        db.Books.Add(book);
+        await db.SaveChangesAsync();
+        return Results.Created($"/books/{book.Id}", new BookResponse(book.Id, book.Title, book.Author));
+    }
+
+    public static async Task<IResult> List(LoansDbContext db)
+        => Results.Ok(await db.Books.OrderBy(b => b.Id).Select(b => new BookResponse(b.Id, b.Title, b.Author)).ToListAsync());
+}
