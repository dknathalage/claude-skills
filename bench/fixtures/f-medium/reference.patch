@@ -0,0 +1,13 @@
+namespace Loans.Api.Loans;
+
+public static class FeeCalculator
+{
+    public const decimal PerDay = 0.50m;
+    public const decimal Cap = 10.00m;
+
+    public static decimal LateFee(DateTime dueOn, DateTime returnedOn)
+    {
+        var days = (int)Math.Floor((returnedOn - dueOn).TotalDays);
+        return days <= 0 ? 0m : Math.Min(days * PerDay, Cap);
+    }
+}
