@@ -0,0 +1,25 @@
+using Loans.Api.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace Loans.Api.Loans;
+
+public sealed record BorrowRequest(int BookId, int MemberId);
+
+public static class BorrowHandler
+{
+    public const int LoanDays = 14;
+    public const int MaxActiveLoans = 3;
+
+    public static async Task<IResult> Borrow(BorrowRequest req, LoansDbContext db, TimeProvider time)
+    {
+        if (!await db.Books.AnyAsync(b => b.Id == req.BookId) || !await db.Members.AnyAsync(m => m.Id == req.MemberId))
+            return Results.NotFound();
+        if (await db.Loans.AnyAsync(l => l.BookId == req.BookId && l.ReturnedOn == null)) return Results.Conflict();
+        if (await db.Loans.CountAsync(l => l.MemberId == req.MemberId && l.ReturnedOn == null) >= MaxActiveLoans) return Results.Conflict();
+        var now = time.GetUtcNow().UtcDateTime;
+        var loan = new Loan { BookId = req.BookId, MemberId = req.MemberId, BorrowedOn = now, DueOn = now.AddDays(LoanDays) };
+        db.Loans.Add(loan);
+        await db.SaveChangesAsync();
+        return Results.Created($"/loans/{loan.Id}", loan.ToResponse());
+    }
+}
