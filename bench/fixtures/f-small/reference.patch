@@ -0,0 +1,16 @@
+namespace Tags;
+
+public enum TagError { Empty, TooLong, InvalidCharacters, BadHyphen }
+
+public static class TagValidator
+{
+    public static TagError? Validate(string normalized)
+    {
+        if (string.IsNullOrEmpty(normalized)) return TagError.Empty;
+        if (normalized.Length > TagsInfo.MaxLength) return TagError.TooLong;
+        foreach (var c in normalized)
+            if (!(c is >= 'a' and <= 'z' or >= '0' and <= '9' or '-')) return TagError.InvalidCharacters;
+        if (normalized[0] == '-' || normalized[^1] == '-') return TagError.BadHyphen;
+        return null;
+    }
+}
