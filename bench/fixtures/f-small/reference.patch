+++ b/src/Tags/TagService.cs
@@ -0,0 +1,23 @@
+namespace Tags;
+
+public sealed record RejectedTag(string Raw, TagError Reason);
+
+public sealed record TagResult(IReadOnlyList<string> Accepted, IReadOnlyList<RejectedTag> Rejected);
+
+public sealed class TagService
+{
+    public TagResult Process(IEnumerable<string> rawTags)
+    {
+        ArgumentNullException.ThrowIfNull(rawTags);
+        var accepted = new List<string>();
+        var seen = new HashSet<string>();
+        var rejected = new List<RejectedTag>();
+        foreach (var raw in rawTags)
+        {
+            var tag = TagNormalizer.Normalize(raw);
+            if (TagValidator.Validate(tag) is { } error) rejected.Add(new RejectedTag(raw, error));
+            else if (seen.Add(tag)) accepted.Add(tag);
+        }
+        return new TagResult(accepted, rejected);
+    }
+}
diff --git a/src/Tags/TagValidator.cs b/src/Tags/TagValidator.cs
