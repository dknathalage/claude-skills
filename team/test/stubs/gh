#!/usr/bin/env node
// Stub for `gh`: answers `gh api <path>` from the JSON map in $GH_STUB_MAP; logs every call to $GH_STUB_LOG.
import { readFileSync, appendFileSync } from 'node:fs';
const args = process.argv.slice(2);
if (process.env.GH_STUB_LOG) appendFileSync(process.env.GH_STUB_LOG, JSON.stringify(args) + '\n');
const map = JSON.parse(readFileSync(process.env.GH_STUB_MAP, 'utf8'));
const [path, query = ''] = (args[1] || '').split('?');
const page = Number(/(?:^|&)page=(\d+)/.exec(query)?.[1] || 1);
const key = Object.keys(map).find(k => k === path || k === `${path}?${query.replace(/&?per_page=100&page=\d+/, '').replace(/^&/, '')}`) ?? path;
const v = map[key];
if (v === undefined) { console.error(`stub: no data for ${path}`); process.exit(1); }
if (typeof v === 'string') process.stdout.write(v);
else process.stdout.write(JSON.stringify(Array.isArray(v) ? (page === 1 ? v : []) : v));
